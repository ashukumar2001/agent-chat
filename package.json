    "build:prod": "tsc -b && CLOUDFLARE_ENV=production vite build",
    "build": "tsc -b && CLOUDFLARE_ENV=development vite build",
    "cf-check-size": "tsc && vite build && wrangler deploy --dry-run",
    "deploy:prod": "wrangler deploy --name eddy",
    "deploy": "wrangler deploy",
    "dev": "CLOUDFLARE_ENV=development vite",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "ui": "bunx --bun shadcn",
    "cf-typegen": "wrangler types -e development",
    "cf-typegen:prod": "wrangler types -e production",
    "db:generate": "drizzle-kit generate",
    "db:generate-better-auth": "npx @better-auth/cli generate --config ./src/worker/lib/auth.ts --output ./src/worker/db/auth-schema.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "CLOUDFLARE_ENV=development drizzle-kit studio",
    "db:studio-local": "CLOUDFLARE_ENV=development drizzle-kit studio --config drizzle-local.config.ts",
    "db:migrate-local": "wrangler d1 migrations apply eddy-ai-chat-db-dev -e development",
    "db:migrate:dev": "CLOUDFLARE_ENV=development drizzle-kit migrate",
    "db:migrate:prod": "CLOUDFLARE_ENV=production drizzle-kit migrate"
