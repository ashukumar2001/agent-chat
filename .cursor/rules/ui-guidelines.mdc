### Component Patterns

#### Memoized Components

```typescript
import { memo, useCallback, useMemo } from "react";

interface ChatItemProps {
  chat: Chat;
  isActive: boolean;
  onDelete: (chatId: string) => void;
}

const ChatItem = memo(function ChatItem({ chat, isActive, onDelete }: ChatItemProps) {
  const handleDelete = useCallback(() => {
    onDelete(chat.id);
  }, [chat.id, onDelete]);

  return (
    <SidebarMenuItem>
      {/* ... */}
    </SidebarMenuItem>
  );
});
```

#### Form Handling

```typescript
const [input, setInput] = useState("");
const [isSubmitting, setIsSubmitting] = useState(false);

const handleSubmit = async (e: React.FormEvent) => {
  e.preventDefault();
  if (!input.trim() || isSubmitting) return;

  setIsSubmitting(true);
  try {
    await submitAction(input);
    setInput("");
  } catch (error) {
    toast.error("Failed to submit");
  } finally {
    setIsSubmitting(false);
  }
};
```

#### Modal Pattern

```typescript
import { useModal } from "@/hooks/use-modal";

const { openModal, closeModal, isOpen } = useModal();

// Open modal
<Button onClick={() => openModal("settings")}>Settings</Button>

// Modal component
{isOpen("settings") && <SettingsModal onClose={() => closeModal("settings")} />}
```

### Routing (TanStack Router)

```typescript
import { Link, useNavigate, useRouterState } from "@tanstack/react-router";

// Navigation
const navigate = useNavigate();
navigate({ to: "/chat/$chatId", params: { chatId: "123" } });

// With state
navigate({
  to: "/chat/$chatId",
  params: { chatId: "123" },
  state: { message: "Hello", chatConfig: { modelId: "gpt-4o" } },
});

// Reading state
const routerState = useRouterState({
  select: (state) => ({
    message: state.location.state?.message,
    chatConfig: state.location.state?.chatConfig,
  }),
});
```

