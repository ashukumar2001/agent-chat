  baseProviderId: string;
  vision?: boolean;
  tools?: boolean;
  webSearch?: boolean;
  reasoning?: boolean;
  apiSdk?: (apiKey?: string) => LanguageModel;
};

// Example model definition
export const openaiModels: ModelConfig[] = [
  {
    id: "gpt-4o",
    name: "GPT-4o",
    provider: "OpenAI",
    providerId: "openai",
    baseProviderId: "openai",
    vision: true,
    tools: true,
    apiSdk: (apiKey) => createOpenAI({ apiKey })("gpt-4o"),
  },
];
```

### User API Key Management

Retrieving user-specific API keys from Durable Objects

```typescript
export async function getUserKey(
  userId: string,
  providerId: string,
  env: Env
): Promise<string> {
  if (!userId) return "";

  const id = env.UserSettings.idFromName(userId);
  const stub = env.UserSettings.get(id);
  return await stub.getUserApiKeyFromProviderId(providerId);
}
```

### Web Search Integration

Enabling web search with Google Search tool

```typescript
import { google } from "@ai-sdk/google";

const result = streamText({
  model: modelInstance,
  messages: this.messages,
  tools:
    modelConfig.webSearch && webSearchEnabled
      ? { google_search: google.tools.googleSearch({}) }
      : otherTools,
});
```

