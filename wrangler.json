/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-chat",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": {
      "vars": {
        "CLOUDFLARE_ENV": "dev"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ChatAgent",
            "class_name": "ChatAgent"
          },
          {
            "name": "UserSettings",
            "class_name": "UserSettings"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v0",
          "new_sqlite_classes": ["ChatAgent", "UserSettings"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "my-db-name",
          "database_id": "9cc06525-7e6f-4b34-a1f7-3a055337b9fb",
          "migrations_dir": "./src/worker/drizzle"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "prod": {
      "vars": {
        "CLOUDFLARE_ENV": "prod"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ChatAgent",
            "class_name": "ChatAgent"
          },
          {
            "name": "UserSettings",
            "class_name": "UserSettings"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v0",
          "new_sqlite_classes": ["ChatAgent", "UserSettings"]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "my-db-name",
          "database_id": "9cc06525-7e6f-4b34-a1f7-3a055337b9fb",
          "migrations_dir": "./src/worker/drizzle"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
